# Setup: cp .env.example .env.local, then fill in real values below.
# Get credentials from the Supabase dashboard, Resend dashboard, and
# OpenRouter/DeepSeek dashboards. Never commit .env.local.
# validateEnv() (lib/utils/env-validation.ts) checks these at startup and
# fails loudly if any required var is missing.

# --- Supabase Auth & Database ---
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

DATABASE_URL=postgresql://user:password@host:5432/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- Email & Notifications ---
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM="BuildableLabs Toolkit <notifications@your-verified-domain.com>"

# --- AI & LLM Services ---
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-v4-flash

# --- App Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Cron & Automation ---
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-actual-cron-secret

# --- Granola (meeting recap ingestion, optional) ---
# See docs/GRANOLA_INTEGRATION.md for setup.
GRANOLA_API_KEY=grn_your-granola-api-key-here
GRANOLA_WEBHOOK_SIGNING_SECRET=whsec_your-webhook-signing-secret-here

# --- Linear (ticket linking, optional) ---
# See docs/LINEAR_INTEGRATION.md for setup. Use a read-only key — v1 never
# creates or edits Linear issues.
LINEAR_API_KEY=lin_api_your-linear-api-key-here

# See docs/SECRET_ROTATION.md for how to rotate any of the above.
